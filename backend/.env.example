# ---------------------------------------------------------------------------
# Bhoomitra backend configuration (copy to .env and edit)
# ---------------------------------------------------------------------------
APP_ENV=development                  # development | test | production
APP_NAME=Bhoomitra
API_PREFIX=/api/v1
DEBUG=true
LOG_JSON=false

# Database (PostgreSQL 16 + PostGIS 3.4 + pgvector)
DATABASE_URL=postgresql+psycopg://bhoomitra:bhoomitra_dev_password@localhost:5432/bhoomitra
TEST_DATABASE_URL=postgresql+psycopg://bhoomitra:bhoomitra_dev_password@localhost:5432/bhoomitra_test

# Security — GENERATE A NEW SECRET FOR ANY REAL DEPLOYMENT
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
# Comma-separated list (a JSON array also works)
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10

# First administrator, created by scripts/seed.py
BOOTSTRAP_SUPERADMIN_EMAIL=admin@bhoomitra.in
BOOTSTRAP_SUPERADMIN_PASSWORD=Admin@Bhoomitra2026

# Background work: thread (single process) | inline (tests) | celery (production)
TASK_EXECUTION_MODE=thread
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Storage: local | s3 (MinIO or AWS)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./var/storage
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=bhoomitra
S3_ACCESS_KEY=
S3_SECRET_KEY=
MAX_UPLOAD_MB=100

# AI: leave AI_PROVIDER=local for the citation-only extractive answerer (no key needed)
AI_PROVIDER=local                    # local | openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=hashing           # hashing | openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
RAG_TOP_K=8

# Search: leave OPENSEARCH_URL empty to use PostgreSQL full-text search
OPENSEARCH_URL=
OPENSEARCH_INDEX=bhoomitra

# Email: console (prints to logs) | smtp
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@bhoomitra.in

# External connectors (optional)
GEOBOUNDARIES_BASE_URL=https://www.geoboundaries.org/api/current/gbOpen
DATAGOV_API_KEY=
STAC_ENDPOINT=

# Demo / Synthetic Data seeding
DEMO_DATA_ENABLED=true
