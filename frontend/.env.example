# Browser-side base URL of the API (leave empty to use same-origin /api rewrite)
NEXT_PUBLIC_API_URL=
# Server-side URL used by Next.js rewrites to reach the backend
API_INTERNAL_URL=http://localhost:8000
# Optional raster basemap tile URL template for MapLibre (defaults to OpenStreetMap tiles; keep attribution)
NEXT_PUBLIC_BASEMAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
